# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* into the app bundle.

# The APP channel's key (Selwise panel → Channels → the app channel's card).
EXPO_PUBLIC_SELWISE_CHANNEL_KEY=sk_...

# An API key with BOTH mobile_read and mobile_write (purpose: "Mobile app").
# It ships inside the app on purpose: its scopes are public reads plus event
# and order writes, nothing else. Never put an ssr_read, orders_write or
# identity secret here.
EXPO_PUBLIC_SELWISE_API_KEY=swpk_live_...

# Optional: a local or staging API. An emulator reaches the host as 10.0.2.2
# (Android) / localhost (iOS simulator).
EXPO_PUBLIC_SELWISE_API_URL=https://api.selwise.com/api/v1

# The Ardisa demo store doubles as this app's backend: sign-in goes to its
# /api/auth/login, which answers with the SIGNED customer id.
EXPO_PUBLIC_STORE_URL=https://demo.selwise.com
