# Ardisa — ortam değişkenleri. `.env.local` olarak kopyalayın.
# Hiçbiri NEXT_PUBLIC_ değildir: hepsi sunucuda, istek anında okunur
# (bir imaj her kanala hizmet eder, site anahtarı derlemeye gömülmez).

# --- Selwise: kanal ---------------------------------------------------------
# Kanalın site anahtarı (Panel → Kanallar → kanalın kartı). Herkese açıktır;
# boşsa mağaza Selwise olmadan çalışır.
SELWISE_SITE_KEY=sk_...
# Varsayılanlar canlı Selwise'tır; yerel ya da test ortamı için değiştirin.
SELWISE_WIDGET_URL=https://widget.selwise.com/client.js
SELWISE_API_URL=https://api.selwise.com/api/v1
SELWISE_DASHBOARD_URL=https://selwise.com/dashboard

# --- Selwise: sunucu anahtarları (yalnızca sunucuda, asla tarayıcıya) -------
# ssr_read: ürün sayfasındaki sunucu taraflı zenginleştirme ve
# /gelistirici/headless'teki sunucuda basılan öneri şeridi.
SELWISE_SSR_API_KEY=swpk_live_...
# Sunucu render çağrısının en fazla bekleyeceği süre (ms); aşılırsa blok
# tarayıcıda çizilir.
SELWISE_SSR_TIMEOUT_MS=400
# mobile_read + mobile_write: iş olayları (test paneli), sunucuda öneri
# şeritlerinin listesi ve sunucuda arama.
SELWISE_SERVER_API_KEY=swpk_live_...
# orders_write: sipariş durumu (kargoya verildi, teslim edildi, iade) — mağazanın
# arka ofisinin Selwise'a bildirdiği.
SELWISE_ORDERS_API_KEY=swpk_live_...

# --- Selwise: sırlar --------------------------------------------------------
# İmzalı kimlik: Panel → Kanallar → kanal → Signed identity → Create secret.
# Boşsa identify imzasız gider (kanal Report modunda saymaya devam eder).
SELWISE_IDENTITY_SECRET=swis_...
# Giden webhook'un HMAC sırrı (Panel → Ayarlar → Entegrasyonlar → webhook).
SELWISE_WEBHOOK_SECRET=

# --- Mağaza -----------------------------------------------------------------
# Feed'deki ürün adresleri ve görseller bu adresle yazılır.
DEMO_STORE_PUBLIC_URL=http://localhost:3003
# SQLite dosyasının klasörü (üyeler, sepetler, siparişler).
DEMO_STORE_DATA_DIR=./data
# Çerez bandını kim çizer: selwise (varsayılan) ya da store (mağazanın kendi
# bandı; panelde "Show the Selwise consent banner" kapalı olmalı).
SELWISE_CONSENT_UI=selwise
# Test panelinin (/demo-panel) anahtarı. Panel fiyat ve stok değiştirir:
# herkese açık bir kurulumda mutlaka verin. Boşsa panel açıktır (yerel geliştirme).
DEMO_PANEL_KEY=
# Yerel SMTP yakalayıcının HTTP gelen kutusu (test panelinin Posta sekmesi).
# Üretimde boş bırakın.
DEMO_MAIL_SINK_URL=
# /gelistirici sayfalarındaki "kaynak" bağlantılarının deposu.
DEMO_PUBLIC_REPO_URL=https://github.com/selimgunaydin/selwise-integrations
