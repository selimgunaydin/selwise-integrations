{
  "name": "@selwise/react-native",
  "version": "1.5.0",
  "description": "Selwise SDK for React Native apps — recommendations, search, tracking and order attribution without a DOM.",
  "license": "MIT",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selimgunaydin/selwise-integrations.git",
    "directory": "react-native"
  },
  "homepage": "https://selwise.com/docs/mobile/overview",
  "bugs": {
    "url": "https://github.com/selimgunaydin/selwise-integrations/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "react-native": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "react-native": "./dist/esm/index.js",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "react-native": "./dist/esm/react/index.js",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/cjs/react/index.js",
      "default": "./dist/esm/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "selwise",
    "react-native",
    "ecommerce",
    "personalization",
    "recommendations",
    "akinon"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }, null, 2) + '\\n')\"",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "prepack": "npm run build",
    "test": "jest",
    "test:cov": "jest --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
